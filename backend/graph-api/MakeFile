.PHONY: sql-gen load-spec init up down test lint

WEB_PORT=8080

sql-gen:
	cd db && sqlc generate

load-spec:
	curl http://localhost:${WEB_PORT}/openapi.json -o openapi.json

up:
	 docker compose up -d --build

migrate:
	docker compose run --rm migrate

down:
	docker compose down

test :
	cd test && go test ./...

lint:
	golangci-lint run ./... --color=always --build-tags=all