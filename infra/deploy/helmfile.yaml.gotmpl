environments:
  prod:
    values:
      - &common
        namespace: {{ requiredEnv "NAMESPACE" }}
        host: {{ requiredEnv "HOST" }}
      - priorityClassName: prod
  stage:
    values:
      - *common
      - priorityClassName: ""
---
helmDefaults:
  wait: true
  timeout: 300

releases:
  - name: quota
    namespace: {{ .Values.namespace }}
    chart: ./charts/quota
    installed: {{ eq .Environment.Name "stage" }}

  - name: postgres
    namespace: {{ .Values.namespace }}
    chart: ./charts/postgres
    values:
      - priorityClassName: {{ .Values.priorityClassName }}

  - name: graph-api
    namespace: {{ .Values.namespace }}
    chart: ./charts/app
    needs: [postgres]
    values:
      - priorityClassName: {{ .Values.priorityClassName }}
        image:
          repository: {{ requiredEnv "IMAGE_REGISTRY" }}/graph-api
          tag: {{ requiredEnv "IMAGE_TAG" }}
        args: [serve]
        port: 8080
        migrations:
          enabled: true
        route:
          pathPrefix: /api
          hostnames: [{{ .Values.host }}]
        secretEnv:
          DB_PASSWORD: {secret: postgres, key: GRAPH_API_DB_PASSWORD}
        env:
          DATABASE_URL: postgres://graph_api:$(DB_PASSWORD)@postgres:5432/graph_api?sslmode=disable
          PORT: 8080
          SERVICE_NAME: graph-api
          DEPLOYMENT_ENVIRONMENT: {{ .Environment.Name }}

  - name: graph-admin-api
    namespace: {{ .Values.namespace }}
    chart: ./charts/app
    needs: [postgres]
    values:
      - priorityClassName: {{ .Values.priorityClassName }}
        image:
          repository: {{ requiredEnv "IMAGE_REGISTRY" }}/graph-admin-api
          tag: {{ requiredEnv "IMAGE_TAG" }}
        args: [serve]
        port: 8081
        migrations:
          enabled: true
        route:
          pathPrefix: /admin-api
          hostnames: [{{ .Values.host }}]
        secretEnv:
          DB_PASSWORD: {secret: postgres, key: GRAPH_ADMIN_API_DB_PASSWORD}
        env:
          DATABASE_URL: postgres://graph_admin_api:$(DB_PASSWORD)@postgres:5432/graph_admin_api?sslmode=disable
          PORT: 8081
          SERVICE_NAME: graph-admin-api
          DEPLOYMENT_ENVIRONMENT: {{ .Environment.Name }}
          GRAPH_API_URL: http://graph-api:8080

  - name: graph-frontapp
    namespace: {{ .Values.namespace }}
    chart: ./charts/app
    values:
      - priorityClassName: {{ .Values.priorityClassName }}
        image:
          repository: {{ requiredEnv "IMAGE_REGISTRY" }}/graph-frontapp
          tag: {{ requiredEnv "IMAGE_TAG" }}
        probes:
          liveness: /
          readiness: /
        resources:
          requests:
            cpu: 5m
            memory: 16Mi
          limits:
            cpu: 200m
            memory: 64Mi
        route:
          pathPrefix: /
          hostnames: [{{ .Values.host }}]

  - name: graph-admin-frontapp
    namespace: {{ .Values.namespace }}
    chart: ./charts/app
    values:
      - priorityClassName: {{ .Values.priorityClassName }}
        image:
          repository: {{ requiredEnv "IMAGE_REGISTRY" }}/graph-admin-frontapp
          tag: {{ requiredEnv "IMAGE_TAG" }}
        probes:
          liveness: /admin/
          readiness: /admin/
        resources:
          requests:
            cpu: 5m
            memory: 16Mi
          limits:
            cpu: 200m
            memory: 64Mi
        route:
          pathPrefix: /admin
          hostnames: [{{ .Values.host }}]
