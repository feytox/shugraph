POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Пароли пользователей бд. Применяются только при первом создании тома postgres-data.
GRAPH_API_DB_PASSWORD=graph_api
GRAPH_ADMIN_API_DB_PASSWORD=graph_admin_api

GRAPH_API_PORT=8080
GRAPH_ADMIN_API_PORT=8081

LOG_LEVEL=info
DEPLOYMENT_ENVIRONMENT=local
